# Copy to your local environment manager; never commit real values.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/nexora
DB_USERNAME=root
DB_PASSWORD=replace-with-local-db-password
JPA_DDL_AUTO=update
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=3600000
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-login
MAIL_PASSWORD=replace-with-smtp-key
MAIL_FROM=verified-sender@example.com

# Optional Gemini technician assistant
NEXORA_AI_ENABLED=false
NEXORA_AI_API_KEY=replace-with-a-valid-gemini-api-key
NEXORA_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NEXORA_AI_MODEL=gemini-2.5-flash
